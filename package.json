{
  "name": "openchemlib-sqlite",
  "version": "5.3.0",
  "description": "The storage and in-memory substructure and similarity search engine of a molecule database, in one SQLite file, computed from the idCode alone with openchemlib-search-wasm",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./index": "./lib/moleculeIndex.js"
  },
  "files": [
    "lib",
    "src"
  ],
  "engines": {
    "node": ">=22.16.0"
  },
  "keywords": [
    "chemistry",
    "sqlite",
    "substructure",
    "openchemlib",
    "molecules"
  ],
  "author": "Luc Patiny",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cheminfo/openchemlib-sqlite.git"
  },
  "bugs": {
    "url": "https://github.com/cheminfo/openchemlib-sqlite/issues"
  },
  "homepage": "https://github.com/cheminfo/openchemlib-sqlite#readme",
  "scripts": {
    "check-types": "tsc --noEmit",
    "clean": "rimraf coverage lib",
    "eslint": "eslint .",
    "eslint-fix": "eslint . --fix",
    "prepack": "npm run tsc",
    "prettier": "prettier --check .",
    "prettier-write": "prettier --write .",
    "schema-svg": "node scripts/drawSchema.ts",
    "test": "npm run test-only && npm run check-types && npm run eslint && npm run prettier",
    "test-only": "vitest run --coverage",
    "tsc": "npm run clean && npm run tsc-build",
    "tsc-build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "ml-spectra-processing": "^14.35.1",
    "ml-xsadd": "^3.0.1",
    "openchemlib-search-wasm": "^2.1.1"
  },
  "devDependencies": {
    "@types/benchmark": "^2.1.5",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@zakodium/tsconfig": "^1.0.5",
    "benchmark": "^2.1.4",
    "eslint": "^9.39.5",
    "eslint-config-cheminfo-typescript": "^22.1.0",
    "openchemlib": "^9.25.1",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
